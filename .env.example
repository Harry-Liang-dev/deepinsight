# Reference only. DeepInsight does not load .env files.
# Keep all credential values empty and inject them from a private shell.

# Application
DEEPINSIGHT_ENV=development
DEEPINSIGHT_TIMEZONE=UTC
DEEPINSIGHT_LOG_LEVEL=INFO
DEEPINSIGHT_LLM_PROVIDER=qwen

# Storage
DEEPINSIGHT_DUCKDB_PATH=data/duckdb/platform.duckdb
DEEPINSIGHT_FAISS_ROOT=data/faiss
DEEPINSIGHT_RAW_ROOT=data/raw
DEEPINSIGHT_SNAPSHOT_ROOT=data/snapshots
DEEPINSIGHT_BACKUP_ROOT=data/backups

# Production API / Worker topology
DEEPINSIGHT_REDIS_URL=redis://127.0.0.1:6379/0
DEEPINSIGHT_REDIS_REPORT_QUEUE_NAME=deepinsight:report_jobs
DEEPINSIGHT_REDIS_POLL_TIMEOUT_SECONDS=5
DEEPINSIGHT_WEB_API_BASE_URL=http://127.0.0.1:8000
DEEPINSIGHT_WEB_REQUEST_TIMEOUT_SECONDS=10

# Optional daily single-asset scheduler
DEEPINSIGHT_SCHEDULER_ENABLED=false
DEEPINSIGHT_SCHEDULER_REPORT_HOUR_UTC=7
DEEPINSIGHT_SCHEDULER_REPORT_MINUTE_UTC=0
DEEPINSIGHT_SCHEDULER_ASSET_IDS=["US:AAPL"]

# Qwen production runtime
QWEN_API_KEY=
QWEN_MODEL_NAME=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_RETRIES=0
QWEN_STORE_REMOTE=false

# OpenAI retained as an optional Provider interface
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_STORE_REMOTE=false

# SEC EDGAR. The User-Agent must include a monitored contact address.
DEEPINSIGHT_PROVIDER_SEC_USER_AGENT=
DEEPINSIGHT_PROVIDER_SEC_CIK_MAP={"US:AAPL":"0000320193"}

# Alpaca Market Data
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://data.alpaca.markets
DEEPINSIGHT_PROVIDER_ALPACA_FEED=iex
DEEPINSIGHT_PROVIDER_ALPACA_ADJUSTMENT=raw

# FRED / ALFRED
FRED_API_KEY=

# Financial Modeling Prep (disabled unless explicitly enabled)
FMP_ENABLED=false
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Stocktwits MCP (OAuth state stays in the Git-ignored token store)
STOCKTWITS_MCP_ENABLED=false
STOCKTWITS_MCP_URL=https://mcp.stocktwits.com/mcp
STOCKTWITS_MCP_TOKEN_STORE=data/auth/stocktwits
STOCKTWITS_MCP_REDIRECT_URI=http://127.0.0.1:8765/callback
STOCKTWITS_MCP_TRUST_ENV=false

# Versioned opt-in live acceptance
DEEPINSIGHT_LIVE_DATASET_VERSION=
DEEPINSIGHT_LIVE_AS_OF_DATE=
DEEPINSIGHT_LIVE_DATA_START=
DEEPINSIGHT_LIVE_DATA_END=
DEEPINSIGHT_LIVE_ROOT=
DEEPINSIGHT_LIVE_EVALUATION_RULES_VERSION=report_quality_v2
DEEPINSIGHT_LIVE_LLM_MAX_RETRIES=1
