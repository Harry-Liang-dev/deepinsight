# Application
DEEPINSIGHT_ENV=development
DEEPINSIGHT_TIMEZONE=UTC

# Local storage paths
DEEPINSIGHT_DUCKDB_PATH=data/duckdb/platform.duckdb
DEEPINSIGHT_FAISS_ROOT=data/faiss
DEEPINSIGHT_RAW_ROOT=data/raw
DEEPINSIGHT_SNAPSHOT_ROOT=data/snapshots
DEEPINSIGHT_BACKUP_ROOT=data/backups

# Logging
DEEPINSIGHT_LOG_LEVEL=INFO

# Redis queue and single Worker
DEEPINSIGHT_REDIS_URL=redis://127.0.0.1:6379/0
DEEPINSIGHT_REDIS_REPORT_QUEUE_NAME=deepinsight:report_jobs
DEEPINSIGHT_REDIS_POLL_TIMEOUT_SECONDS=5

# Official SEC Provider production composition. The CIK map is JSON.
DEEPINSIGHT_PROVIDER_SEC_USER_AGENT=
DEEPINSIGHT_PROVIDER_SEC_CIK_MAP={"US:AAPL":"0000320193"}

# Scheduler is opt-in and submits only configured single-asset requests.
DEEPINSIGHT_SCHEDULER_ENABLED=false
DEEPINSIGHT_SCHEDULER_REPORT_HOUR_UTC=7
DEEPINSIGHT_SCHEDULER_REPORT_MINUTE_UTC=0
DEEPINSIGHT_SCHEDULER_ASSET_IDS=["US:AAPL"]

# Read-only report Web
DEEPINSIGHT_WEB_API_BASE_URL=http://127.0.0.1:8000
DEEPINSIGHT_WEB_REQUEST_TIMEOUT_SECONDS=10

# OpenAI
# Keep secrets empty in this file. Set the real value only in the environment
# or in a local, Git-ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BATCH_SIZE=20
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_STORE_REMOTE=false

# Temporary, opt-in DashScope Qwen compatibility smoke only.
# These values are not used by the production DeepInsight LLM Gateway.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.6-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ENABLE_THINKING=false
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Opt-in SEC EDGAR live report acceptance. Identify automated access with a
# monitored contact address as required by SEC Fair Access.
SEC_USER_AGENT=
DEEPINSIGHT_LIVE_ROOT=
